{
  "cli": {
    "version": ">= 18.3.0",
    "appVersionSource": "local"
  },
  "build": {
    "base": {
      "node": "22.0.0"
    },
    "development": {
      "extends": "base",
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "env": {
        "APP_VARIANT": "development",
        "APP_BUNDLE_ID": "com.invitehub.app.dev",
        "APP_ANDROID_PACKAGE": "com.invitehub.app.dev"
      },
      "ios": {
        "simulator": false,
        "resourceClass": "m-medium"
      }
    },
    "development-simulator": {
      "extends": "base",
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "env": {
        "APP_VARIANT": "development",
        "APP_BUNDLE_ID": "com.invitehub.app.dev",
        "APP_ANDROID_PACKAGE": "com.invitehub.app.dev"
      },
      "ios": {
        "simulator": true
      }
    },
    "preview": {
      "extends": "base",
      "distribution": "internal",
      "channel": "preview",
      "env": {
        "APP_VARIANT": "development",
        "APP_BUNDLE_ID": "com.invitehub.app.dev",
        "APP_ANDROID_PACKAGE": "com.invitehub.app.dev"
      },
      "ios": {
        "resourceClass": "m-medium"
      }
    },
    "production": {
      "extends": "base",
      "distribution": "store",
      "autoIncrement": false,
      "channel": "production",
      "env": {
        "APP_VARIANT": "production",
        "APP_BUNDLE_ID": "com.invitehub.app",
        "APP_ANDROID_PACKAGE": "com.invitehub.app"
      },
      "ios": {
        "resourceClass": "m-medium"
      }
    },
    "production-local": {
      "extends": "production",
      "autoIncrement": false
    },
    "testflight": {
      "extends": "production"
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6763630299"
      },
      "android": {
        "track": "internal"
      }
    },
    "testflight": {
      "ios": {
        "ascAppId": "6763630299"
      }
    }
  }
}
